MODEL_PRESET=gemma4_instruct_31b
MODEL_BASE=/kaggle/input/models/keras/gemma4/keras/gemma4_instruct_31b
MODEL_PATH=

HOST=0.0.0.0
PORT=7860

EXPECTED_TPU_DEVICES=8
EXPECTED_LIBTPU_VERSION=0.0.17
INSTALL_LIBTPU_IF_MISSING=auto
KAGGLE_TPU_FALLBACK=auto
REQUIRE_V5E8=true
TPU_CHIPS_PER_HOST_BOUNDS_FALLBACK=2,4,1
TPU_HOST_BOUNDS_FALLBACK=1,1,1
TPU_ACCELERATOR_TYPE_FALLBACK=v5e-8

MESH_SHAPE=1,8
MESH_AXIS_NAMES=batch,model
DATA_PARALLEL_AXIS=batch
MODEL_PARALLEL_AXIS=model
MODEL_DTYPE=bfloat16

VISION_ENABLED=true
GENERATION_MODE=native
GENERATION_LENGTH_BUCKETS=16,512,768,1024,1536,2048
MAX_GENERATION_LENGTH=2048
DEFAULT_OUTPUT_TOKENS=128
MAX_OUTPUT_TOKENS=512
MAX_INPUT_CHARS=12000
MAX_IMAGE_BYTES=5242880
MAX_IMAGE_PIXELS=20000000
MAX_REQUEST_BYTES=8388608

MAX_QUEUE_SIZE=8
MAX_STORE_SIZE=500
RESULT_TTL_SECONDS=3600
REQUEST_TIMEOUT=900
WORKER_LOAD_TIMEOUT=1800
SHUTDOWN_TIMEOUT=300
MAX_WORKER_RESTARTS=1

MEMORY_GUARD_GIB=300
MEMORY_POLL_SECONDS=1.0
MIN_SHARDED_PARAMETER_PERCENT=80

JAX_PLATFORMS=tpu,cpu
JAX_COMPILATION_CACHE_DIR=/kaggle/working/.cache/gemma4-31b-jax
JAX_PERSISTENT_CACHE_MIN_COMPILE_TIME_SECS=1
JAX_PERSISTENT_CACHE_MIN_ENTRY_SIZE_BYTES=-1

API_AUTH_REQUIRED=true
API_KEY=
RESTART_SECRET=
